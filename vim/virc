" vim: ft=vim
" This configures vim-minimal, not vi proper

colorscheme smau-minimal
set nocompatible

" Hybrid line numbering
" set number
" set relativenumber
" set cursorline

" Tabs
set tabstop=8

" Indentation
set autoindent
set smartindent

" Backup
set undofile
set backup
set undodir=~/.vim/.undo//
set backupdir=~/.vim/.backup//
set directory=~/.vim/.swp//

" Show hidden characters
set listchars=tab:│\ ,trail:-
set list

" Disable mouse
set mouse=

set spelllang=en
set spell
set spelloptions=camel
